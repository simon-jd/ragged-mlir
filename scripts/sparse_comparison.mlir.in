// Project-owned CSR max/softmax using public sparse_tensor unary/reduce and official LLVM lowering.
// No handwritten replacement GPU kernels.
#CSR = #sparse_tensor.encoding<{
  map = (d0, d1) -> (d0 : dense, d1 : compressed),
  posWidth = 64, crdWidth = 64
}>
#reduce = {
  indexing_maps = [affine_map<(i,j) -> (i,j)>, affine_map<(i,j) -> (i)>],
  iterator_types = ["parallel", "reduction"]
}
#broadcast = {
  indexing_maps = [affine_map<(i,j) -> (i,j)>, affine_map<(i,j) -> (i)>, affine_map<(i,j) -> (i,j)>],
  iterator_types = ["parallel", "parallel"]
}

module {
  func.func @segment_max(%a: tensor<@B@x@L@xf32, #CSR>) -> tensor<@B@xf32> {
    %identity = arith.constant 0xFF800000 : f32
    %empty = tensor.empty() : tensor<@B@xf32>
    %init = linalg.fill ins(%identity : f32) outs(%empty : tensor<@B@xf32>) -> tensor<@B@xf32>
    %max = linalg.generic #reduce ins(%a : tensor<@B@x@L@xf32, #CSR>) outs(%init : tensor<@B@xf32>) {
      ^bb0(%x: f32, %acc: f32):
        %present = sparse_tensor.unary %x : f32 to f32
          present={ ^bb1(%v: f32): sparse_tensor.yield %v : f32 }
          absent={}
        %next = sparse_tensor.reduce %present, %acc, %identity : f32 {
          ^bb2(%lhs: f32, %rhs: f32):
            %value = arith.maximumf %lhs, %rhs : f32
            sparse_tensor.yield %value : f32
        }
        linalg.yield %next : f32
    } -> tensor<@B@xf32>
    return %max : tensor<@B@xf32>
  }

  func.func @softmax(%a: tensor<@B@x@L@xf32, #CSR>, %max: tensor<@B@xf32>) -> tensor<@B@x@L@xf32, #CSR> {
    %empty = tensor.empty() : tensor<@B@x@L@xf32, #CSR>
    %weights = linalg.generic #broadcast ins(%a, %max : tensor<@B@x@L@xf32, #CSR>, tensor<@B@xf32>) outs(%empty : tensor<@B@x@L@xf32, #CSR>) {
      ^bb0(%x: f32, %m: f32, %unused: f32):
        %weight = sparse_tensor.unary %x : f32 to f32
          present={
            ^bb1(%v: f32):
              %shift = arith.subf %v, %m : f32
              %e = math.exp %shift : f32
              sparse_tensor.yield %e : f32
          }
          absent={}
        linalg.yield %weight : f32
    } -> tensor<@B@x@L@xf32, #CSR>
    %zero = arith.constant 0.0 : f32
    %sum_empty = tensor.empty() : tensor<@B@xf32>
    %sum_init = linalg.fill ins(%zero : f32) outs(%sum_empty : tensor<@B@xf32>) -> tensor<@B@xf32>
    %total = linalg.generic #reduce ins(%weights : tensor<@B@x@L@xf32, #CSR>) outs(%sum_init : tensor<@B@xf32>) {
      ^bb0(%x: f32, %acc: f32):
        %next = sparse_tensor.reduce %x, %acc, %zero : f32 {
          ^bb1(%lhs: f32, %rhs: f32):
            %value = arith.addf %lhs, %rhs : f32
            sparse_tensor.yield %value : f32
        }
        linalg.yield %next : f32
    } -> tensor<@B@xf32>
    %out_empty = tensor.empty() : tensor<@B@x@L@xf32, #CSR>
    %out = linalg.generic #broadcast ins(%weights, %total : tensor<@B@x@L@xf32, #CSR>, tensor<@B@xf32>) outs(%out_empty : tensor<@B@x@L@xf32, #CSR>) {
      ^bb0(%x: f32, %sum: f32, %unused: f32):
        %prob = sparse_tensor.unary %x : f32 to f32
          present={
            ^bb1(%v: f32):
              %p = arith.divf %v, %sum : f32
              sparse_tensor.yield %p : f32
          }
          absent={}
        linalg.yield %prob : f32
    } -> tensor<@B@x@L@xf32, #CSR>
    bufferization.dealloc_tensor %weights : tensor<@B@x@L@xf32, #CSR>
    bufferization.dealloc_tensor %total : tensor<@B@xf32>
    return %out : tensor<@B@x@L@xf32, #CSR>
  }


  // Shape-specialized CSR dimensions are required by upstream assemble.
  // All input buffers are actual external memrefs and are borrowed, not freed.
  func.func @run_max(%values: memref<?xf32>, %positions: memref<?xi64>,
                     %coordinates: memref<?xi64>, %output: memref<?xf32>) attributes {llvm.emit_c_interface} {
    %v = bufferization.to_tensor %values restrict : memref<?xf32> to tensor<?xf32>
    %p = bufferization.to_tensor %positions restrict : memref<?xi64> to tensor<?xi64>
    %c = bufferization.to_tensor %coordinates restrict : memref<?xi64> to tensor<?xi64>
    %input = sparse_tensor.assemble (%p, %c), %v : (tensor<?xi64>, tensor<?xi64>), tensor<?xf32> to tensor<@B@x@L@xf32, #CSR>
    %maximum = call @segment_max(%input) : (tensor<@B@x@L@xf32, #CSR>) -> tensor<@B@xf32>
    %max_buffer = bufferization.to_buffer %maximum : tensor<@B@xf32> to memref<@B@xf32>
    %dynamic_max = memref.cast %max_buffer : memref<@B@xf32> to memref<?xf32>
    memref.copy %dynamic_max, %output : memref<?xf32> to memref<?xf32>
    bufferization.dealloc_tensor %maximum : tensor<@B@xf32>
    return
  }

  func.func @run_softmax(%values: memref<?xf32>, %positions: memref<?xi64>,
                        %coordinates: memref<?xi64>, %output: memref<?xf32>,
                        %out_positions: memref<?xi64>, %out_coordinates: memref<?xi64>,
                        %count: memref<?xi64>, %audit: i1) attributes {llvm.emit_c_interface} {
    %v = bufferization.to_tensor %values restrict : memref<?xf32> to tensor<?xf32>
    %p = bufferization.to_tensor %positions restrict : memref<?xi64> to tensor<?xi64>
    %c = bufferization.to_tensor %coordinates restrict : memref<?xi64> to tensor<?xi64>
    %input = sparse_tensor.assemble (%p, %c), %v : (tensor<?xi64>, tensor<?xi64>), tensor<?xf32> to tensor<@B@x@L@xf32, #CSR>
    %maximum = call @segment_max(%input) : (tensor<@B@x@L@xf32, #CSR>) -> tensor<@B@xf32>
    %result = call @softmax(%input, %maximum) : (tensor<@B@x@L@xf32, #CSR>, tensor<@B@xf32>) -> tensor<@B@x@L@xf32, #CSR>
    %packed = sparse_tensor.values %result : tensor<@B@x@L@xf32, #CSR> to memref<?xf32>
    %nse = sparse_tensor.number_of_entries %result : tensor<@B@x@L@xf32, #CSR>
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %n = memref.dim %values, %c0 : memref<?xf32>
    %same_n = arith.cmpi eq, %nse, %n : index
    cf.assert %same_n, "sparse softmax changed the explicit stored entry count"
    scf.for %i = %c0 to %nse step %c1 {
      %x = memref.load %packed[%i] : memref<?xf32>
      memref.store %x, %output[%i] : memref<?xf32>
    }
    scf.if %audit {
      %rp = sparse_tensor.positions %result {level = 1 : index} : tensor<@B@x@L@xf32, #CSR> to memref<?xi64>
      %rc = sparse_tensor.coordinates %result {level = 1 : index} : tensor<@B@x@L@xf32, #CSR> to memref<?xi64>
      %end = memref.dim %positions, %c0 : memref<?xi64>
      scf.for %i = %c0 to %end step %c1 {
        %x = memref.load %rp[%i] : memref<?xi64>
        memref.store %x, %out_positions[%i] : memref<?xi64>
      }
      scf.for %i = %c0 to %nse step %c1 {
        %x = memref.load %rc[%i] : memref<?xi64>
        memref.store %x, %out_coordinates[%i] : memref<?xi64>
      }
      %n64 = arith.index_cast %nse : index to i64
      memref.store %n64, %count[%c0] : memref<?xi64>
    }
    bufferization.dealloc_tensor %maximum : tensor<@B@xf32>
    bufferization.dealloc_tensor %result : tensor<@B@x@L@xf32, #CSR>
    return
  }
}
