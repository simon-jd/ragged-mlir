<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-authored narrow rules using NVIDIA's documented Api suppression schema.
     Not a captured sanitizer report. Only isolated loader_api tests may use it.
     Reference: CUDA 13.2 Compute Sanitizer, Error suppression / API error suppression.
     No device errors, other APIs, or unrelated cuModuleLoadData results are suppressed. -->
<ComputeSanitizerOutput>
  <record>
    <kind>Api</kind>
    <what>
      <api>^cuModuleLoadData$</api>
      <error>^CUDA_ERROR_INVALID_IMAGE$</error>
      <result>200</result>
    </what>
  </record>
  <record>
    <kind>Api</kind>
    <what>
      <api>^cuModuleLoadData$</api>
      <error>^CUDA_ERROR_NO_BINARY_FOR_GPU$</error>
      <result>209</result>
    </what>
  </record>
</ComputeSanitizerOutput>
